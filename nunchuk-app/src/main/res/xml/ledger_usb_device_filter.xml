<?xml version="1.0" encoding="utf-8"?>
<!--
    Devices that make Nunchuk an option when a USB device is attached. Ledger's USB vendor id
    is 0x2c97; this file takes decimal, so 11415. No product-id, so every Ledger model matches.
-->
<resources>
    <usb-device vendor-id="11415" />
</resources>
