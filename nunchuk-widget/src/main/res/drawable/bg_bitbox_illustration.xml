<?xml version="1.0" encoding="utf-8"?>
<!--
    App-bar illustration for the BitBox add-key screens (design screen 01), the BitBox
    counterpart of bg_ledger_illustration.

    Converted from the design asset bitbox-hero.svg, which replaced the earlier
    connect-bitbox.svg: the desk-and-laptop scene is gone, leaving the device on its own
    at 1.8x. Like the 02A/02B assets the artwork is a 238px band, so it is offset by 62
    to sit at the bottom of the 375x300 panel NcImageAppBar draws — the same panel size
    as bg_bitbox_instructions_* and bg_ledger_illustration.

    Must stay a <vector>: NcImageAppBar loads it with painterResource, which rejects
    anything that is not a VectorDrawable or a raster. The backdrop uses
    @color/nc_fill_denim rather than the asset SVG's literal #D0E2FF so it tracks the
    theme, exactly as bg_ledger_illustration does — the asset value is that colour's
    light-mode entry.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="375dp"
    android:height="300dp"
    android:viewportWidth="375"
    android:viewportHeight="300">
    <path
        android:pathData="M0,0h375v300h-375z"
        android:fillColor="@color/nc_fill_denim" />

    <group android:translateY="62">
        <group
            android:translateX="142.4"
            android:translateY="58"
            android:scaleX="1.8"
            android:scaleY="1.8">
            <group
                android:translateX="-165.14"
                android:translateY="-108">
