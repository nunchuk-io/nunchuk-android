<?xml version="1.0" encoding="utf-8"?>
<!--
    App-bar illustration for "Add your BitBox" over Bluetooth (design screen 02A):
    BitBoxApp on the phone, paired over the air with an upright BitBox.

    Converted from the design asset 02a-bitbox-instructions-bluetooth.svg. Its artwork
    lives in the top 238px band of the 375x812 mock, so it is offset by 62 here to sit
    at the bottom of the 375x300 panel NcImageAppBar draws — same panel size as
    bg_bitbox_illustration and bg_ledger_illustration.

    Must stay a <vector>: NcImageAppBar loads it with painterResource, which rejects
    anything that is not a VectorDrawable or a raster. The backdrop uses
    @color/nc_fill_denim rather than the asset SVG's literal #D0E2FF so it tracks the
    theme — the asset value is that colour's light-mode entry.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="375dp"
    android:height="300dp"
    android:viewportWidth="375"
    android:viewportHeight="300">
    <path
        android:pathData="M0,0h375v300h-375z"
        android:fillColor="@color/nc_fill_denim" />

    <group android:translateY="62">
        <path
            android:pathData="M0 169c57-33 106 38 175 18 77-23 126-79 200-31v82H0v-69Z"
            android:fillColor="#ABEDD8"
            android:fillAlpha="0.58" />

        <!-- BitBoxApp on the phone -->
        <path
            android:pathData="M83,61H142A16,16 0 0 1 158,77V186A16,16 0 0 1 142,202H83A16,16 0 0 1 67,186V77A16,16 0 0 1 83,61Z"
            android:fillColor="#FFFFFF"
            android:strokeColor="#031F2B"
            android:strokeWidth="1.5" />
        <path
            android:pathData="M86,75H139A8,8 0 0 1 147,83V166A8,8 0 0 1 139,174H86A8,8 0 0 1 78,166V83A8,8 0 0 1 86,75Z"
            android:fillColor="#ABEDD8" />
        <path
            android:pathData="M108.5,188A4,4 0 1 0 116.5,188A4,4 0 1 0 108.5,188Z"
            android:fillColor="#031F2B" />

        <!-- Wireless link. VectorDrawable has no stroke dash array, so the design's
             "2 7" dashes are drawn as explicit segments. -->
        <path
            android:pathData="M158,131h2M167,131h1M226,131h2M235,131h1"
            android:fillColor="#00000000"
            android:strokeColor="#031F2B"
            android:strokeWidth="2.5"
            android:strokeLineCap="round" />
        <path
            android:pathData="M168,131A29,29 0 1 0 226,131A29,29 0 1 0 168,131Z"
            android:fillColor="#FFFFFF"
            android:strokeColor="#031F2B"
            android:strokeWidth="2" />
        <path
            android:pathData="M194 107v48l18-16-18-17 18-15-18 15-14-12m14 12-14 13"
            android:fillColor="#00000000"
            android:strokeColor="#031F2B"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- BitBox -->
        <group
            android:translateX="235"
            android:translateY="72"
            android:scaleX="1.2"
            android:scaleY="1.2">
            <group
                android:translateX="-165.14"
                android:translateY="-108">
                <path
                    android:pathData="M169.14,108H211.25A4,4 0 0 1 215.25,112V172.33A4,4 0 0 1 211.25,176.33H169.14A4,4 0 0 1 165.14,172.33V112A4,4 0 0 1 169.14,108Z"
                    android:fillColor="#78C7E0"
                    android:strokeColor="#333333"
                    android:strokeWidth="0.6" />
                <path
                    android:pathData="m199.24 152.86-6.93 2.97v-22.11l13.83-5.94v8.46l-6.9 3.27v13.35ZM188.08 155.83l-6.93-2.97v-13.35l-6.9-3.27v-8.46l13.83 5.94v22.11ZM190.21 118.25l14.32 6.19-14.32 6.19-14.31-6.19 14.31-6.19Z"
                    android:fillColor="#48466D" />
                <path
                    android:pathData="M182.39 190h16v-13.67h-16V190Z"
                    android:fillColor="#46CDCF"
                    android:strokeColor="#333333"
                    android:strokeWidth="0.6" />
            </group>
        </group>
    </group>
</vector>
